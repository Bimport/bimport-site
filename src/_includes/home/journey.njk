<figure class="journey-photo journey-carousel wrap" id="journey" role="region" aria-roledescription="カルーセル" aria-label="5台の輸入車ギャラリー">
 <div class="journey-stage">
  <div class="journey-slides" id="journey-slides" aria-live="off">
   {% for car in homeJourney %}
   <div class="journey-slide{% if loop.first %} is-active{% endif %}" role="group" aria-roledescription="スライド" aria-label="{{ loop.index }} / {{ homeJourney.length }}：{{ car.name }}" aria-hidden="{% if loop.first %}false{% else %}true{% endif %}">
    <picture>
     <source type="image/webp" srcset="assets/images/home/journey/{{ car.key }}-640.webp 640w, assets/images/home/journey/{{ car.key }}-1000.webp 1000w, assets/images/home/journey/{{ car.key }}-1536.webp 1536w" sizes="(max-width: 767px) 100vw, (max-width: 1440px) 85vw, 1224px">
     <img src="assets/images/home/journey/{{ car.key }}-1536.jpg" alt="{{ car.alt }}" width="1536" height="1024" loading="lazy" decoding="async">
    </picture>
    <div class="journey-car-caption"><span>{{ car.maker }}</span><strong>{{ car.model }}</strong></div>
   </div>
   {% endfor %}
  </div>
  <div class="journey-heading" aria-hidden="true">YOUR NEXT CHAPTER.</div>
 </div>
 <figcaption class="journey-toolbar">
  <div class="journey-select" role="group" aria-label="表示する車を選択" hidden>
   {% for car in homeJourney %}
   <button type="button" data-journey-slide="{{ loop.index0 }}" aria-label="{{ car.name }}を表示" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}" aria-controls="journey-slides"><span>0{{ loop.index }}</span><i aria-hidden="true"></i></button>
   {% endfor %}
  </div>
  <small class="journey-note">AI生成の車種イメージ</small>
  <button type="button" class="journey-pause" aria-label="車の写真の自動切り替えを停止" aria-pressed="false" hidden><span aria-hidden="true">Ⅱ</span></button>
  <span class="visually-hidden journey-status" role="status"></span>
 </figcaption>
</figure>
