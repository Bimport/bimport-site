{#- 車種別LP共通：アイコン（線画SVG）と LINE マーク。各部品で {% from "vehicle-lp/macros.njk" import icon, lineMark %} して使う -#}
{%- macro icon(name) -%}
<svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if name == "yen" -%}<circle cx="12" cy="12" r="9"/><path d="M8.5 7l3.5 5 3.5-5M12 12v5.5M9 12.5h6M9 15h6"/>
{%- elif name == "truck" -%}<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/>
{%- elif name == "doc" -%}<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 15.5h6M9 8.5h3"/>
{%- elif name == "search" -%}<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5.5 5.5M8 10.5h5M10.5 8v5"/>
{%- elif name == "star" -%}<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z"/>
{%- elif name == "chart" -%}<path d="M4 20h16M6.5 17v-4M10.5 17V9.5M14.5 17v-6M18.5 17V5.5"/>
{%- elif name == "map" -%}<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>
{%- elif name == "form" -%}<rect x="4.5" y="3.5" width="15" height="17" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>
{%- elif name == "chat" -%}<path d="M4 5.5h16v10H10l-4 3.5v-3.5H4z"/><path d="M8 10.5h.01M12 10.5h.01M16 10.5h.01"/>
{%- elif name == "car" -%}<path d="M4 15.5v-3l2-4.5h12l2 4.5v3z"/><path d="M4 15.5v2.5h3v-2.5M17 15.5v2.5h3v-2.5M4 12.5h16"/><circle cx="7.5" cy="14" r=".6"/><circle cx="16.5" cy="14" r=".6"/>
{%- elif name == "check" -%}<rect x="4.5" y="3.5" width="15" height="17" rx="2"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
{%- elif name == "camera" -%}<path d="M3.5 7.5h4l1.5-2h6l1.5 2h4v11h-17z"/><circle cx="12" cy="13" r="3.5"/>
{%- elif name == "seat" -%}<path d="M8 3.5h5l-1 9h5.5l1.5 6H8.5z"/><path d="M7 20.5h11"/>
{%- elif name == "wheel" -%}<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3.5v6M12 14.5v6M3.5 12h6M14.5 12h6"/>
{%- elif name == "badge" -%}<circle cx="12" cy="9.5" r="5.5"/><path d="M9 14.2L7.5 21l4.5-2.5 4.5 2.5-1.5-6.8"/>
{%- endif -%}
</svg>
{%- endmacro -%}
{%- macro lineMark() -%}<span class="lp-linemark" aria-hidden="true">LINE</span>{%- endmacro -%}
