{#-
  車種別買取LP 共通テンプレート（ページ全体）
  v = 車種データ（src/_data/vehicles/<slug>.json）、site = 共通設定（src/_data/site.json）
  各セクションは vehicle-lp/sections/ 以下の部品を順に読み込む
-#}
{%- set pageUrl = site.siteUrl + "/" + v.slug + "/" -%}
{%- set heroImage = v.images.hero.src if (v.images and v.images.hero) else "" -%}
{%- set ogImage = (v.images.og if (v.images and v.images.og) else heroImage) -%}
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ v.seo.title }}</title>
<meta name="description" content="{{ v.seo.description }}">
<link rel="canonical" href="{{ pageUrl }}">
{%- if v.draft %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}

<!-- OGP -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Bimport">
<meta property="og:title" content="{{ v.seo.ogTitle or v.seo.title }}">
<meta property="og:description" content="{{ v.seo.ogDescription or v.seo.description }}">
<meta property="og:url" content="{{ pageUrl }}">
{%- if ogImage %}
<meta property="og:image" content="{{ site.siteUrl }}/{{ ogImage }}">
{%- endif %}
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=M+PLUS+1p:wght@800;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap">
<link rel="stylesheet" href="../assets/css/vehicle-lp.css">

<!-- Google tag (gtag.js) -->
{% include "ga4.njk" %}
</head>
<body>

{% include "vehicle-lp/sections/header.njk" %}

<main>

{% include "vehicle-lp/sections/hero.njk" %}

{% include "vehicle-lp/sections/estimate-form.njk" %}

{% include "vehicle-lp/sections/reasons.njk" %}

{% include "vehicle-lp/sections/reviews.njk" %}

{% include "vehicle-lp/sections/cases.njk" %}

{% include "vehicle-lp/sections/line.njk" %}

{% include "vehicle-lp/sections/points.njk" %}

{% include "vehicle-lp/sections/flow.njk" %}

{% include "vehicle-lp/sections/faq.njk" %}

{% include "vehicle-lp/sections/final.njk" %}

</main>

{% include "vehicle-lp/sections/footer.njk" %}

<script src="../assets/js/estimate-form.js" defer></script>
<script src="../assets/js/vehicle-lp.js" defer></script>
</body>
</html>
