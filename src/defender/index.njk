---
permalink: "defender/index.html"
---
{%- set v = vehicles.defender -%}
{%- set pageUrl = site.siteUrl + "/defender/" -%}
{%- set pageTitle = "ディフェンダー買取・査定｜売却未定でも概算価格がわかる｜Bimport" -%}
{%- set pageDescription = "ランドローバー ディフェンダー（90 / 110 / 130）の買取・査定ならBimport。グレードや装備、カスタム内容まで見て評価します。売却が決まっていなくても、60秒の入力で概算査定額をご案内。査定無料・全国対応。" -%}
{%- set heroImage = v.cases[0].image -%}
{#- アイコン（線画SVG）。車種別LPでも共通で使う想定 -#}
{%- macro icon(name) -%}
<svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if name == "yen" -%}<circle cx="12" cy="12" r="9"/><path d="M8.5 7l3.5 5 3.5-5M12 12v5.5M9 12.5h6M9 15h6"/>
{%- elif name == "truck" -%}<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/>
{%- elif name == "doc" -%}<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 15.5h6M9 8.5h3"/>
{%- elif name == "search" -%}<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5.5 5.5M8 10.5h5M10.5 8v5"/>
{%- elif name == "star" -%}<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z"/>
{%- elif name == "chart" -%}<path d="M4 20h16M6.5 17v-4M10.5 17V9.5M14.5 17v-6M18.5 17V5.5"/>
{%- elif name == "map" -%}<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>
{%- elif name == "form" -%}<rect x="4.5" y="3.5" width="15" height="17" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>
{%- elif name == "chat" -%}<path d="M4 5.5h16v10H10l-4 3.5v-3.5H4z"/><path d="M8 10.5h.01M12 10.5h.01M16 10.5h.01"/>
{%- elif name == "car" -%}<path d="M4 15.5v-3l2-4.5h12l2 4.5v3z"/><path d="M4 15.5v2.5h3v-2.5M17 15.5v2.5h3v-2.5M4 12.5h16"/><circle cx="7.5" cy="14" r=".6"/><circle cx="16.5" cy="14" r=".6"/>
{%- elif name == "check" -%}<rect x="4.5" y="3.5" width="15" height="17" rx="2"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
{%- elif name == "camera" -%}<path d="M3.5 7.5h4l1.5-2h6l1.5 2h4v11h-17z"/><circle cx="12" cy="13" r="3.5"/>
{%- elif name == "seat" -%}<path d="M8 3.5h5l-1 9h5.5l1.5 6H8.5z"/><path d="M7 20.5h11"/>
{%- elif name == "wheel" -%}<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3.5v6M12 14.5v6M3.5 12h6M14.5 12h6"/>
{%- elif name == "badge" -%}<circle cx="12" cy="9.5" r="5.5"/><path d="M9 14.2L7.5 21l4.5-2.5 4.5 2.5-1.5-6.8"/>
{%- endif -%}
</svg>
{%- endmacro -%}
{%- macro lineMark() -%}<span class="lp-linemark" aria-hidden="true">LINE</span>{%- endmacro -%}
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ pageUrl }}">

<!-- OGP -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Bimport">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ site.siteUrl }}/{{ heroImage }}">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=M+PLUS+1p:wght@800;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap">
<link rel="stylesheet" href="../assets/css/vehicle-lp.css">

<!-- Google tag (gtag.js) -->
{% include "ga4.njk" %}
</head>
<body>

<header class="lp-header" id="lp-header">
  <div class="lp-container lp-header__inner">
    <a class="lp-logo" href="../">
      <span class="lp-logo__name">Bimport</span>
      <span class="lp-logo__sub">輸入車専門買取店</span>
    </a>
    <nav class="lp-nav" id="lp-nav" aria-label="ページ内メニュー">
      <a href="#cases">買取実績</a>
      <a href="#reasons">選ばれる理由</a>
      <a href="#points">査定ポイント</a>
      <a href="#flow">買取の流れ</a>
      <a href="#faq">よくある質問</a>
      <a class="lp-btn lp-btn--gold lp-btn--sm lp-nav__cta" href="#estimate" data-cta="header">60秒で概算査定</a>
      <a class="lp-nav__line" href="{{ site.lineUrl }}" data-cta="header" data-cta-type="line">LINEで写真査定</a>
    </nav>
    <button class="lp-menu-btn" type="button" aria-controls="lp-nav" aria-expanded="false" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>

  <!-- ============ ファーストビュー ============ -->
  <section class="lp-hero">
    <div class="lp-hero__bg" aria-hidden="true"></div>
    <div class="lp-container lp-hero__inner">
      <div class="lp-hero__copy">
        <p class="lp-hero__label">ランドローバー ディフェンダー買取・査定</p>
        <h1 class="lp-hero__title">
          <span class="lp-hero__maker">LAND ROVER</span>
          <span class="lp-hero__model">DEFENDER</span>
          <span class="lp-hero__buy">高価買取</span>
        </h1>
        <p class="lp-hero__catch">今の愛車、いくらになる？</p>
        <p class="lp-hero__lead">売却未定でもOK。<br>まずは概算価格だけでもお気軽に。</p>
      </div>
      <div class="lp-hero__photo">
        <img src="../{{ heroImage }}" alt="ランドローバー ディフェンダー 90" width="1200" height="896" fetchpriority="high">
      </div>
      <ul class="lp-hero__badges">
        <li>{{ icon("yen") }}<span>査定<br>無料</span></li>
        <li>{{ icon("truck") }}<span>全国<br>対応</span></li>
        <li>{{ icon("doc") }}<span>概算だけ<br>でもOK</span></li>
      </ul>
    </div>
  </section>

  <!-- ============ 60秒概算査定フォーム ============ -->
  <section class="lp-estimate" id="estimate">
    <div class="lp-container">
      {%- set formConfig = {
        maker: v.maker,
        model: v.model,
        bodyTypes: v.form.bodyTypes,
        gradeFallback: v.form.gradeFallback,
        yearFrom: v.form.yearFrom,
        yearOlderLabel: v.form.yearOlderLabel,
        unknownLabel: estimateForm.unknownLabel,
        endpoint: site.estimateEndpoint
      } %}
      <script type="application/json" id="estimate-config">{{ formConfig | dump | safe }}</script>

      <div class="lp-form-card" id="estimate-app">
        <h2 class="lp-form-card__title">かんたん<em>60</em><small>秒</small>で概算査定</h2>
        <div class="lp-form-card__meta">
          <p class="lp-form-card__vehicle"><span>対象車種</span>{{ v.maker }} {{ v.model }}</p>
          <p class="lp-form-card__easy">お車の情報4項目＋お名前・電話番号だけ</p>
        </div>

        <div class="lp-progress" aria-label="入力ステップ">
          <p class="lp-progress__label">STEP <span id="estimate-step-num">1</span>/3</p>
          <ol class="lp-progress__steps">
            <li class="is-current" data-step-indicator="1"><i></i>お車について</li>
            <li data-step-indicator="2"><i></i>お客様情報</li>
            <li data-step-indicator="3"><i></i>確認</li>
          </ol>
        </div>

        <form id="estimate-form" novalidate>
          <!-- 迷惑送信対策（人には見えない欄。入力があった送信は受け付け側で破棄する） -->
          <div class="lp-hp" aria-hidden="true">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
          </div>
          <!-- STEP 1 -->
          <fieldset class="lp-step" data-step="1">
            <legend class="lp-visually-hidden">STEP 1｜お車について</legend>

            <div class="lp-field" data-field="bodyType">
              <p class="lp-label">ボディタイプ<span class="lp-req">必須</span></p>
              <div class="lp-choices" role="radiogroup">
                {%- for b in v.form.bodyTypes %}
                <label class="lp-choice"><input type="radio" name="bodyType" value="{{ b.label }}" data-body="{{ b.value }}"><span>{{ b.label }}</span></label>
                {%- endfor %}
              </div>
              <p class="lp-error" aria-live="polite"></p>
            </div>

            <div class="lp-field" data-field="grade">
              <label class="lp-label" for="f-grade">グレード<span class="lp-req">必須</span></label>
              <select class="lp-input" id="f-grade" name="grade" disabled>
                <option value="">ボディタイプを先に選択</option>
              </select>
              <p class="lp-error" aria-live="polite"></p>
            </div>

            <div class="lp-field" data-field="year">
              <label class="lp-label" for="f-year">年式<span class="lp-req">必須</span></label>
              <select class="lp-input" id="f-year" name="year">
                <option value="">選択してください</option>
              </select>
              <p class="lp-error" aria-live="polite"></p>
            </div>

            <div class="lp-field" data-field="mileage">
              <label class="lp-label" for="f-mileage">走行距離<span class="lp-req">必須</span></label>
              <select class="lp-input" id="f-mileage" name="mileage">
                <option value="">選択してください</option>
                {%- for m in estimateForm.mileageOptions %}
                <option value="{{ m }}">{{ m }}</option>
                {%- endfor %}
              </select>
              <p class="lp-error" aria-live="polite"></p>
            </div>

            <div class="lp-step__actions">
              <button type="button" class="lp-btn lp-btn--gold lp-btn--block lp-btn--next" data-next>次へ</button>
            </div>
          </fieldset>

          <!-- STEP 2 -->
          <fieldset class="lp-step" data-step="2" hidden>
            <legend class="lp-visually-hidden">STEP 2｜お客様情報</legend>

            <div class="lp-field" data-field="name">
              <label class="lp-label" for="f-name">お名前<span class="lp-req">必須</span></label>
              <input class="lp-input" id="f-name" name="name" type="text" autocomplete="name" maxlength="40" placeholder="例）山田">
              <p class="lp-note">名字だけでも大丈夫です</p>
              <p class="lp-error" aria-live="polite"></p>
            </div>

            <div class="lp-field" data-field="phone">
              <label class="lp-label" for="f-phone">電話番号<span class="lp-req">必須</span></label>
              <input class="lp-input" id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="16" placeholder="例）090-1234-5678">
              <p class="lp-note">概算査定額のご案内に使用します</p>
              <p class="lp-error" aria-live="polite"></p>
            </div>

            <div class="lp-field" data-field="prefecture">
              <label class="lp-label" for="f-pref">都道府県<span class="lp-opt">任意</span></label>
              <select class="lp-input" id="f-pref" name="prefecture" autocomplete="address-level1">
                <option value="">選択してください</option>
                {%- for p in estimateForm.prefectures %}
                <option value="{{ p }}">{{ p }}</option>
                {%- endfor %}
              </select>
            </div>

            <div class="lp-step__actions lp-step__actions--split">
              <button type="button" class="lp-btn lp-btn--ghost" data-prev>戻る</button>
              <button type="button" class="lp-btn lp-btn--gold lp-btn--next" data-next>確認へ</button>
            </div>
          </fieldset>

          <!-- STEP 3 -->
          <fieldset class="lp-step" data-step="3" hidden>
            <legend class="lp-visually-hidden">STEP 3｜入力内容の確認</legend>
            <p class="lp-step__lead">入力内容をご確認ください</p>
            <dl class="lp-confirm" id="estimate-confirm"></dl>
            <div class="lp-step__actions lp-step__actions--confirm">
              <button type="submit" class="lp-btn lp-btn--gold lp-btn--block lp-btn--next" id="estimate-submit">無料で概算査定を依頼する</button>
              <button type="button" class="lp-btn lp-btn--ghost lp-btn--block" data-prev>入力内容を修正する</button>
            </div>
            <p class="lp-note lp-note--center">送信いただいた内容は<a href="../privacy.html">プライバシーポリシー</a>に基づき取り扱います。</p>
            <p class="lp-error lp-error--submit" aria-live="polite"></p>
          </fieldset>
        </form>

        <!-- 送信完了 -->
        <div class="lp-done" id="estimate-done" hidden tabindex="-1">
          <p class="lp-done__mark" aria-hidden="true">✓</p>
          <p class="lp-done__title">査定依頼を受け付けました</p>
          <p class="lp-done__text">担当者よりご連絡のうえ、<br>概算査定額をご案内します。</p>
          <div class="lp-done__line">
            <p class="lp-done__line-lead">より詳しい概算査定をご希望の場合は、<br>LINEでお車の写真を送ってください。</p>
            <ul class="lp-photo-list">
              <li>車全体</li>
              <li>内装</li>
              <li>メーター</li>
              <li>車検証<small>（任意）</small></li>
            </ul>
            <a class="lp-btn lp-btn--line lp-btn--block" href="{{ site.lineUrl }}" data-cta="done" data-cta-type="line">{{ lineMark() }}LINEで写真を送る</a>
          </div>
        </div>

        <noscript>
          <p class="lp-noscript">フォームのご利用にはJavaScriptを有効にしてください。<a href="{{ site.lineUrl }}">公式LINE</a>からもご相談いただけます。</p>
        </noscript>

        <p class="lp-form-notice">※ ご入力いただいた車両情報をもとに、担当者より概算査定額をご案内します。正式な買取金額は実車査定後にご提示いたします。</p>
      </div>
    </div>
  </section>

  <!-- ============ Bimportが選ばれる理由 ============ -->
  <section class="lp-reasons" id="reasons">
    <div class="lp-container">
      <h2 class="lp-reasons__title"><span class="lp-en">Bimport</span><small>が</small><br>選ばれる理由</h2>
      <ul class="lp-reasons__list">
        <li>{{ icon("search") }}<span>輸入車専門<br>の査定力</span></li>
        <li>{{ icon("star") }}<span>Google<br>口コミ評価</span></li>
        <li>{{ icon("chart") }}<span>年間200台<br>以上の実績</span></li>
        <li>{{ icon("map") }}<span>全国対応<br>査定無料</span></li>
      </ul>
      <p class="lp-reasons__lead">車種・グレード・オプションまで見て、適正に評価します。<br class="pc-only">遠方の方も、売却が決まっていない段階でもご相談いただけます。</p>
    </div>
  </section>

  <!-- ============ お客様の声（Google口コミ） ============ -->
  <section class="lp-section lp-section--light" id="reviews">
    <div class="lp-container lp-container--mid">
      <h2 class="lp-h2">お客様の声</h2>
      <div class="lp-rating">
        <p class="lp-rating__label">Google口コミより{% if site.googleRating %} <strong>{{ site.googleRating }}</strong> / 5{% endif %}</p>
        <p class="lp-rating__stars" aria-hidden="true">★★★★★</p>
      </div>
      <div class="lp-reviews">
        {%- for r in reviews %}
        <article class="lp-review">
          <p class="lp-review__stars" aria-label="{{ r.stars }}つ星">{% for i in range(0, r.stars) %}★{% endfor %}</p>
          <h3 class="lp-review__title">「{{ r.title }}」</h3>
          <p class="lp-review__vehicle">{{ r.vehicle }}</p>
          <p class="lp-review__body">{{ r.body }}</p>
        </article>
        {%- endfor %}
      </div>
      <p class="lp-center"><a class="lp-btn lp-btn--outline" href="{{ site.googleReviewsUrl }}" target="_blank" rel="noopener">Google口コミをもっと見る</a></p>
    </div>
  </section>

  <!-- ============ 買取実績 ============ -->
  <section class="lp-section" id="cases">
    <div class="lp-container lp-container--mid">
      <h2 class="lp-h2"><span class="lp-en">DEFENDER</span>の買取実績</h2>
      <p class="lp-h2__sub">実際の買取事例をご紹介します。</p>
      <div class="lp-cases">
        {%- for c in v.cases %}
        <article class="lp-case">
          <div class="lp-case__row">
            <div class="lp-case__photo">
              <img src="../{{ c.image }}" alt="買取実績：{{ c.maker }} {{ c.model }} {{ c.grade }}" width="1200" height="896" loading="lazy">
            </div>
            <div class="lp-case__info">
              <p class="lp-case__maker">{{ c.maker }}</p>
              <h3 class="lp-case__name">{{ c.model }}<span>{{ c.grade }}</span></h3>
              <p class="lp-case__meta"><span>{{ c.year }}</span><span>走行 {{ c.mileage }}</span></p>
            </div>
            <p class="lp-case__price"><span class="lp-case__price-label">買取金額</span><span class="lp-case__price-num">{{ c.price }}</span><span class="lp-case__price-unit">{{ c.priceUnit }}</span></p>
          </div>
          <dl class="lp-case__spec">
            <div><dt>買取時期</dt><dd>{{ c.purchasedAt }}</dd></div>
            <div><dt>地域</dt><dd>{{ c.area }}</dd></div>
          </dl>
          <ul class="lp-case__details">
            {%- for d in c.details %}
            <li>{{ d }}</li>
            {%- endfor %}
          </ul>
        </article>
        {%- endfor %}
      </div>
      <p class="lp-center"><a class="lp-btn lp-btn--outline lp-btn--small" href="../">その他の車種の買取実績を見る</a></p>
    </div>
  </section>

  <!-- ============ LINE写真査定 ============ -->
  <section class="lp-line" id="line">
    <picture class="lp-line__photo">
      <source type="image/webp" srcset="../assets/images/defender/line-photo-1000.webp 1000w, ../assets/images/defender/line-photo-1672.webp 1672w" sizes="100vw">
      <img src="../assets/images/defender/line-photo-1672.jpg" alt="海沿いの道を走る白いランドローバー ディフェンダー" width="1672" height="941" loading="lazy" decoding="async">
    </picture>
    <div class="lp-container lp-line__inner">
      <div class="lp-line__text">
        <h2 class="lp-line__title">あなたの<span class="lp-en">DEFENDER</span>、<br>まずは写真で概算査定。</h2>
        <p class="lp-line__lead">LINEで写真を送るだけ。<br>売却未定でもお気軽にご相談ください。</p>
      </div>
      <div class="lp-line__cta">
        <a class="lp-btn lp-btn--gold lp-btn--line-gold" href="{{ site.lineUrl }}" data-cta="line-section" data-cta-type="line">{{ lineMark() }}LINEで写真査定する</a>
      </div>
    </div>
  </section>

  <!-- ============ ディフェンダーの査定ポイント ============ -->
  <section class="lp-section" id="points">
    <div class="lp-container">
      <h2 class="lp-h2"><span class="lp-en">DEFENDER</span>の査定ポイント</h2>
      <p class="lp-h2__sub">仕様によって価値が大きく変わるディフェンダー。<br>詳しいスタッフが、1台ごとに確認して査定します。</p>
      <ul class="lp-points">
        {%- for p in v.checkPoints %}
        <li class="lp-point">
          <div class="lp-point__img lp-point__img--{{ p.key }}">
            {%- if p.image %}
            <img src="../{{ p.image }}" alt="{{ p.title }}" loading="lazy">
            {%- elif p.key == "interior" %}{{ icon("seat") }}
            {%- elif p.key == "wheel" %}{{ icon("wheel") }}
            {%- elif p.key == "limited" %}{{ icon("badge") }}
            {%- else %}{{ icon("car") }}<span class="lp-point__ph">{{ p.placeholderLabel }}</span>
            {%- endif %}
          </div>
          <h3 class="lp-point__title">{{ p.title }}</h3>
          <p class="lp-point__text">{{ p.text }}</p>
        </li>
        {%- endfor %}
      </ul>
      <div class="lp-points__more">
        <p class="lp-points__more-title">そのほかにも、ここまで確認します</p>
        <ul>
          {%- for m in v.checkPointsMore %}
          <li>{{ m }}</li>
          {%- endfor %}
        </ul>
      </div>
      <p class="lp-points__close">同じディフェンダーでも、仕様の見極め次第で査定額は変わります。<br class="pc-only">だからこそ、<strong>車種に詳しい査定</strong>が大切です。</p>
    </div>
  </section>

  <!-- ============ 買取の流れ ============ -->
  <section class="lp-section lp-section--light" id="flow">
    <div class="lp-container lp-container--mid">
      <h2 class="lp-h2">買取の流れ</h2>
      <p class="lp-h2__sub">はじめての方でも安心。かんたん4ステップ。</p>
      <ol class="lp-flow">
        <li>
