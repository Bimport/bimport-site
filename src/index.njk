    <div style="background: #FFFFFF; border: 1px solid #E7E1D2; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; gap: 10px;">
      <div class="serif" style="font-size: 14px; font-weight: 700; color: #1C1A16;">Bimport 岡山オフィス</div>
      <div style="font-size: 12.5px; line-height: 2; color: #4A4536;">
        〒{{ site.officePostalCode }}　{{ site.officeRegion }}{{ site.officeLocality }}{{ site.officeStreetAddress }}<br>
        TEL：<a href="{{ site.phoneHref }}" style="color: #16324F; text-decoration: underline;">{{ site.phoneDisplay }}</a>　／　FAX：{{ site.faxDisplay }}
      </div>
      <a href="{{ site.mapsUrl }}" style="display: inline-block; font-size: 12px; color: #16324F; text-decoration: underline; margin-top: 2px;">Google マップで見る</a>
    </div>

    <div style="font-size: 12px; line-height: 2; color: #5A5343;">
      運営会社（登記上本店）：Bgroup株式会社<br>
      本店所在地：{{ site.hqAddressDisplay }}　／　TEL：{{ site.hqPhoneDisplay }}<br>
      事業内容：中古車の査定・買取・販売<br>
      古物商許可：{{ site.license }}<br>
      <a href="privacy.html" style="color: #16324F; text-decoration: underline;">プライバシーポリシー</a>
    </div>
  </div>

  <!-- ============ 13. 最終CTA ============ -->
  <div style="padding: 36px 24px 90px; background: #FFFFFF; display: flex; flex-direction: column; gap: 12px; align-items: stretch;">
    <div class="serif" style="color: #1C1A16; font-size: 17px; font-weight: 700; text-align: center;">まずは無料相談から</div>
    <div style="color: #1C1A16; font-size: 12.5px; text-align: center; line-height: 1.75;">友だち追加後、車の情報と写真を送るだけです</div>
    <a href="{{ site.lineUrl }}" data-cta="final" data-cta-type="line" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #06C755; color: #FFFFFF; font-weight: 700; font-size: 16px; padding: 17px 20px; border-radius: 8px;">
      公式LINEで無料相談する
    </a>
    <a href="{{ site.phoneHref }}" data-cta="final" data-cta-type="tel" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: transparent; color: #1C1A16; font-weight: 600; font-size: 13.5px; padding: 13px 20px; border-radius: 8px; border: 1px solid #D8CFB8;">
      電話で相談する（{{ site.phoneDisplay }}）
    </a>
  </div>

  <!-- ============ 追従CTAバー ============ -->
  <div style="position: sticky; bottom: 0; left: 0; right: 0; background: #FFFFFF; border-top: 1px solid #E7E1D2; padding: 10px 16px; display: flex; gap: 8px; box-shadow: 0 -4px 16px rgba(0,0,0,0.08);">
    <a href="{{ site.phoneHref }}" data-cta="sticky" data-cta-type="tel" style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; background: #FFFFFF; color: #1C1A16; font-weight: 700; font-size: 13px; padding: 13px 10px; border-radius: 8px; border: 1px solid #D8CFB8;">
      電話で相談
    </a>
    <a href="{{ site.lineUrl }}" data-cta="sticky" data-cta-type="line" style="flex: 1.4; display: flex; align-items: center; justify-content: center; gap: 6px; background: #06C755; color: #FFFFFF; font-weight: 700; font-size: 13px; padding: 13px 10px; border-radius: 8px;">
