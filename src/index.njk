<body>

<div style="width: 100%; max-width: 480px; margin: 0 auto; box-sizing: border-box; display: flex; flex-direction: column; background: #F5F2EA; position: relative;">

  <!-- ============ 会員バー ============ -->
  <div class="bar-light" style="background: #3A3226; color: #F5F2EA; padding: 8px 20px; display: flex; align-items: center; justify-content: space-between; font-size: 11px; letter-spacing: 0.06em; position: relative; overflow: hidden;">
    <span style="z-index: 1;">輸入車買取専門 ── Bimport</span>
    <span style="z-index: 1;">岡山</span>
  </div>

  <!-- ============ 1. ファーストビュー ============ -->
  <div style="padding: 40px 24px 36px; background: #FFFFFF; color: #1C1A16; display: flex; flex-direction: column; gap: 16px; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -60px; right: -60px; width: 200px; height: 200px; border: 1px solid rgba(201,169,97,0.25); border-radius: 999px;"></div>
    <div style="position: absolute; top: -20px; right: -20px; width: 200px; height: 200px; border: 1px solid rgba(201,169,97,0.18); border-radius: 999px;"></div>

    <div class="serif" style="font-size: 24px; font-weight: 700; letter-spacing: 0.06em; color: #C9A961; z-index: 1;">Bimport</div>
    <div style="font-size: 12px; color: #1C1A16; z-index: 1;">運営：Bgroup株式会社</div>

    <h1 class="serif" style="margin: 8px 0 0; font-size: 27px; line-height: 1.65; font-weight: 700; color: #1C1A16; z-index: 1;">輸入車の価値を、<br>見誤らない査定を。</h1>
    <p style="margin: 0; font-size: 14.5px; line-height: 1.9; color: #1C1A16; z-index: 1;">岡山を拠点に、輸入車の相場・グレード・装備を見極める専門査定。国産車の買取にも対応しています。</p>

    <div style="margin-top: 8px; height: 1px; background: linear-gradient(90deg, rgba(201,169,97,0.7), rgba(201,169,97,0));"></div>

    <div style="display: flex; gap: 18px; z-index: 1;">
      <div>
        <div class="serif" style="font-size: 20px; font-weight: 700; color: #C9A961;">無料</div>
        <div style="font-size: 11px; color: #1C1A16; margin-top: 2px;">相談・概算査定</div>
      </div>
      <div>
        <div class="serif" style="font-size: 20px; font-weight: 700; color: #C9A961;">輸入車</div>
        <div style="font-size: 11px; color: #1C1A16; margin-top: 2px;">専門の相場判断</div>
      </div>
      <div>
        <div class="serif" style="font-size: 20px; font-weight: 700; color: #C9A961;">国産車</div>
        <div style="font-size: 11px; color: #1C1A16; margin-top: 2px;">もあわせて対応</div>
      </div>
    </div>

    <div style="margin-top: 14px; display: flex; flex-direction: column; gap: 10px; z-index: 1;">
      <a href="{{ site.lineUrl }}" data-cta="hero" data-cta-type="line" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #06C755; color: #FFFFFF; font-weight: 700; font-size: 16px; padding: 17px 20px; border-radius: 8px;">
        公式LINEで無料相談する
      </a>
      <a href="{{ site.phoneHref }}" data-cta="hero" data-cta-type="tel" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: transparent; color: #1C1A16; font-weight: 600; font-size: 14px; padding: 14px 20px; border-radius: 8px; border: 1px solid #D8CFB8;">
        電話で相談する（{{ site.phoneDisplay }}）
      </a>
      <div style="font-size: 11.5px; color: #1C1A16; text-align: center;">友だち追加後、車種・年式・写真を送るだけ</div>
    </div>
  </div>

  <!-- ============ 写真：対応ブランドイメージ ============ -->
  <img src="assets/images/photos/brand-lineup.jpg" alt="Bimportが買取対応する輸入車・国産車のイメージ" style="width: 100%; height: auto; display: block;">

  <!-- ============ 対応ブランド帯 ============ -->
  <div style="padding: 16px 24px; background: #FFFFFF; border-bottom: 1px solid #E7E1D2; display: flex; flex-direction: column; gap: 10px;">
    <div style="font-size: 11px; color: #8D8270; text-align: center; letter-spacing: 0.05em;">対応ブランド（一例）</div>
    <div style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;">
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">Porsche</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">Mercedes-Benz</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">BMW</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">Land Rover</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">Maserati</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">Peugeot</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">MINI</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">Jaguar</span>
      <span style="font-size: 12px; border: 1px solid #D8CFB8; border-radius: 4px; padding: 5px 11px; color: #4A4536;">アメ車全般</span>
    </div>
  </div>

  <!-- ============ 2. 対応可否 ============ -->
  <div style="padding: 36px 24px; display: flex; flex-direction: column; gap: 16px; border-bottom: 1px solid #E7E1D2;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <div style="width: 24px; height: 1px; background: #C9A961;"></div>
      <div style="font-size: 11px; color: #8D8270; letter-spacing: 0.1em;">CONSULTATION</div>
    </div>
    <h2 class="serif" style="margin: 0; font-size: 20px; font-weight: 700; color: #1C1A16;">こんなご相談をお受けしています</h2>

    <div style="display: flex; flex-direction: column; gap: 0;">
      <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #EDE8DB;">
        <span class="serif" style="color: #C9A961; font-size: 15px; font-weight: 700;">01</span>
        <span style="font-size: 14px; line-height: 1.7; padding-top: 1px;">輸入車・国産車を問わず、車種にかかわらずご相談いただけます</span>
      </div>
      <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #EDE8DB;">
        <span class="serif" style="color: #C9A961; font-size: 15px; font-weight: 700;">02</span>
        <span style="font-size: 14px; line-height: 1.7; padding-top: 1px;">年式が古い、走行距離が多い車</span>
      </div>
      <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #EDE8DB;">
        <span class="serif" style="color: #C9A961; font-size: 15px; font-weight: 700;">03</span>
        <span style="font-size: 14px; line-height: 1.7; padding-top: 1px;">一括査定やディーラー下取りで希望額が出なかった車</span>
      </div>
      <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px 0;">
        <span class="serif" style="color: #C9A961; font-size: 15px; font-weight: 700;">04</span>
        <span style="font-size: 14px; line-height: 1.7; padding-top: 1px;">修復歴や不具合があり、売れるか不安な車</span>
      </div>
    </div>

    <div class="accent-light-soft" style="background: linear-gradient(135deg, #3A3226 0%, #14120E 100%); border-radius: 10px; padding: 18px; display: flex; flex-direction: column; gap: 8px; position: relative; overflow: hidden;">
      <div class="serif gold-stroke" style="font-size: 14px; font-weight: 700; color: #C9A961; z-index: 1;">対応エリアについて</div>
      <p style="margin: 0; font-size: 13px; line-height: 1.85; color: #D8D0C0; z-index: 1;">岡山県を拠点に、広島・鳥取・島根・四国など周辺エリアへの出張査定にも対応しています。それ以外の遠方の方も、車両情報・写真・売却のご意向を確認したうえで、個別に対応可否を判断します。</p>
      <p style="margin: 0; font-size: 12px; line-height: 1.7; color: #8D8270; z-index: 1;">「全国どこでも無料出張」といった一律のお約束はしておりません。ご相談内容に応じて都度ご案内します。</p>
    </div>
  </div>

  <!-- ============ 3. 選ばれる理由 ============ -->
  <div style="padding: 36px 24px; display: flex; flex-direction: column; gap: 18px; border-bottom: 1px solid #E7E1D2; background: #FFFFFF;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <div style="width: 24px; height: 1px; background: #C9A961;"></div>
      <div style="font-size: 11px; color: #8D8270; letter-spacing: 0.1em;">WHY BIMPORT</div>
    </div>
    <h2 class="serif" style="margin: 0; font-size: 20px; font-weight: 700; color: #1C1A16;">なぜBimportに相談する価値があるか</h2>
    <p style="margin: 0; font-size: 13.5px; line-height: 1.85;">運営会社はBgroup株式会社です。輸入車の仕入れ・販売・査定を中心に扱ってきた経験をもとに、車種ごとの相場観と装備・グレードの見極めに強みがあります。</p>

    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="display: flex; gap: 14px; align-items: flex-start; background: #F5F2EA; border-radius: 10px; padding: 16px;">
        <div class="serif" style="width: 34px; height: 34px; border: 1px solid #C9A961; border-radius: 999px; color: #C9A961; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">1</div>
        <div>
          <div style="font-size: 14px; font-weight: 700; color: #1C1A16;">オークション相場に基づく判断</div>
          <div style="font-size: 12.5px; line-height: 1.75; color: #5A5343; margin-top: 4px;">USSなど、実際に成約しているオークション相場を確認したうえで金額を検討します。相場観だけに頼らず、直近の成約データを見ます。</div>
        </div>
      </div>
      <div style="display: flex; gap: 14px; align-items: flex-start; background: #F5F2EA; border-radius: 10px; padding: 16px;">
        <div class="serif" style="width: 34px; height: 34px; border: 1px solid #C9A961; border-radius: 999px; color: #C9A961; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">2</div>
        <div>
          <div style="font-size: 14px; font-weight: 700; color: #1C1A16;">装備・グレードの見極め</div>
          <div style="font-size: 12.5px; line-height: 1.75; color: #5A5343; margin-top: 4px;">エンジン仕様、地域限定パッケージ、内外装オプションなど、金額に影響する装備差を確認したうえで判断します。</div>
        </div>
      </div>
      <div style="display: flex; gap: 14px; align-items: flex-start; background: #F5F2EA; border-radius: 10px; padding: 16px;">
        <div class="serif" style="width: 34px; height: 34px; border: 1px solid #C9A961; border-radius: 999px; color: #C9A961; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">3</div>
        <div>
          <div style="font-size: 14px; font-weight: 700; color: #1C1A16;">担当者が直接、最初から最後まで対応</div>
          <div style="font-size: 12.5px; line-height: 1.75; color: #5A5343; margin-top: 4px;">金額の確認・提示はすべて担当者が行います。AIが自動で確定額を出す仕組みではありません。</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ 写真：査定リサーチイメージ ============ -->
  <img src="assets/images/photos/research-laptop-blurred.jpg" alt="相場をリサーチする様子のイメージ写真" style="width: 100%; height: auto; display: block;">

  <!-- ============ 4. 他社との違い ============ -->
  <div style="padding: 36px 24px; display: flex; flex-direction: column; gap: 16px; border-bottom: 1px solid #E7E1D2;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <div style="width: 24px; height: 1px; background: #C9A961;"></div>
      <div style="font-size: 11px; color: #8D8270; letter-spacing: 0.1em;">COMPARISON</div>
    </div>
    <h2 class="serif" style="margin: 0; font-size: 20px; font-weight: 700; color: #1C1A16;">一括査定サイトとの違い</h2>

    <div style="background: #FFFFFF; border-radius: 12px; overflow: hidden; border: 1px solid #E7E1D2;">
      <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr;">
        <div style="padding: 12px 10px; font-size: 11.5px; color: #8D8270;"></div>
        <div style="padding: 12px 10px; font-size: 12px; font-weight: 700; text-align: center; color: #8D8270;">一括査定</div>
        <div class="serif" style="padding: 12px 10px; font-size: 12.5px; font-weight: 700; text-align: center; background: #14120E; color: #C9A961;">Bimport</div>
      </div>
      <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr; border-top: 1px solid #EDE8DB;">
        <div style="padding: 12px 10px; font-size: 12.5px; color: #4A4536;">複数社からの連絡</div>
        <div style="padding: 12px 10px; font-size: 12px; text-align: center; color: #8D8270;">同時に多数</div>
        <div style="padding: 12px 10px; font-size: 12px; text-align: center; color: #1C1A16; font-weight: 600;">窓口は1つ</div>
      </div>
      <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr; border-top: 1px solid #EDE8DB;">
        <div style="padding: 12px 10px; font-size: 12.5px; color: #4A4536;">対応の専門性</div>
        <div style="padding: 12px 10px; font-size: 12px; text-align: center; color: #8D8270;">業者による</div>
        <div style="padding: 12px 10px; font-size: 12px; text-align: center; color: #1C1A16; font-weight: 600;">輸入車に強い</div>
      </div>
      <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr; border-top: 1px solid #EDE8DB;">
