<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AutomotiveBusiness",
  "name": "Bimport",
  "alternateName": "Bgroup株式会社",
  "description": "岡山を拠点とする輸入車・国産車の査定・買取専門店。",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.officeStreetAddress }}",
    "addressLocality": "{{ site.officeLocality }}",
    "addressRegion": "{{ site.officeRegion }}",
    "postalCode": "{{ site.officePostalCode }}",
    "addressCountry": "JP"
  },
  "telephone": "{{ site.phoneE164 }}",
  "areaServed": ["岡山県", "広島県", "鳥取県", "島根県", "四国地方"]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "国産車でも相談できますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "はい。国産車も買取対象です。" }
    },
    {
      "@type": "Question",
      "name": "岡山県外に住んでいますが相談できますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "車両情報・写真・移動条件を確認したうえで、対応可否を個別にご案内します。" }
    },
    {
      "@type": "Question",
      "name": "修復歴があっても売れますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "修復歴の有無にかかわらず、まずはご相談ください。" }
    },
    {
      "@type": "Question",
      "name": "相談後に断ることはできますか？",
      "acceptedAnswer": { "@type": "Answer", "text": "もちろん可能です。契約前であればいつでもお断りいただけます。" }
    }
  ]
}
</script>

